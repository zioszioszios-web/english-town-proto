{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "tests"]
}
