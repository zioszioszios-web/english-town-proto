{
  "location": "Pharmacy",
  "npcName": "Morgan",
  "npcRole": "Pharmacist",
  "npcRoleZh": "藥師",
  "scenarios": [
    {
      "id": "pharmacy-lv1-essentials",
      "title": "A toothbrush, please",
      "titleZh": "購買旅行用品",
      "level": 1,
      "nodes": [
        {
          "id": "hello",
          "npc": "Hi! Can I help you find something?",
          "npcZh": "嗨！需要幫你找東西嗎？",
          "replies": [
            {
              "type": "branch",
              "next": "color",
              "en": "Yes, please. I need a toothbrush.",
              "zh": "好，謝謝。我需要一支牙刷。"
            },
            {
              "type": "branch",
              "next": "paste",
              "en": "I'm looking for toothpaste. Do you have a small one?",
              "zh": "我在找牙膏，有小條的嗎？"
            }
          ]
        },
        {
          "id": "color",
          "npc": "Sure. We have blue ones and green ones. Which one do you want?",
          "npcZh": "好的，有藍色和綠色，你要哪一種？",
          "replies": [
            {
              "type": "branch",
              "next": "blue",
              "en": "The blue one, please.",
              "zh": "藍色的，謝謝。"
            },
            {
              "type": "branch",
              "next": "green",
              "en": "Green, please. It's my favorite color.",
              "zh": "綠色，那是我最喜歡的顏色。"
            }
          ]
        },
        {
          "id": "blue",
          "npc": "Here's a blue one. Do you need toothpaste, too?",
          "npcZh": "這是藍色的。也需要牙膏嗎？",
          "replies": [
            {
              "type": "branch",
              "next": "pay",
              "en": "No, thanks. I have some.",
              "zh": "不用，謝謝，我有。"
            }
          ]
        },
        {
          "id": "green",
          "npc": "Oh, sorry. We don't have any green ones right now. Is blue OK?",
          "npcZh": "喔，抱歉，綠色的現在沒貨了。藍色可以嗎？",
          "replies": [
            {
              "type": "branch",
              "next": "pay",
              "en": "Sure, blue is fine.",
              "zh": "好，藍色也可以。"
            }
          ]
        },
        {
          "id": "paste",
          "npc": "Yes, this small one is great for trips.",
          "npcZh": "有，這條小的很適合旅行帶。",
          "replies": [
            {
              "type": "branch",
              "next": "pay",
              "en": "Perfect. I'm going on a trip tomorrow!",
              "zh": "太好了，我明天要去旅行！"
            }
          ]
        },
        {
          "id": "pay",
          "npc": "Is that everything for today?",
          "npcZh": "今天就這些嗎？",
          "replies": [
            {
              "type": "branch",
              "next": "price",
              "en": "Yes, that's all. How much is it?",
              "zh": "對，就這些。多少錢？"
            },
            {
              "type": "mistake",
              "en": "Yes. It is how much?",
              "zh": "對。它是多少錢？",
              "reaction": {
                "en": "Sorry? Oh, the price? Just a second.",
                "zh": "抱歉？喔，價錢嗎？請稍等。"
              },
              "correction": "How much is it?",
              "explain": "英文問價錢要把疑問詞放句首：How much is it?，不能照中文語序說 It is how much?"
            }
          ]
        },
        {
          "id": "price",
          "npc": "It's three dollars. Do you need a bag?",
          "npcZh": "三塊錢。需要袋子嗎？",
          "replies": [
            {
              "type": "branch",
              "next": "bye",
              "en": "No, thanks. I have a bag with me.",
              "zh": "不用，謝謝，我有帶袋子。"
            }
          ]
        },
        {
          "id": "bye",
          "npc": "Here you go. Have a great trip!",
          "npcZh": "給你。祝你旅途愉快！",
          "replies": [
            {
              "type": "branch",
              "next": null,
              "en": "Thanks! Have a nice day!",
              "zh": "謝謝！祝你有美好的一天！"
            }
          ]
        }
      ],
      "location": "Pharmacy"
    }
  ]
}
